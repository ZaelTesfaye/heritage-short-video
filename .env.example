# Copy this file to .env and fill in your own keys. .env is git-ignored.

# Google AI Studio -> Get API key (free tier). Used for narration (TTS) and translation.
GEMINI_API_KEY=

# Cloudflare dashboard -> Workers AI -> "Use REST API". Used for keyframes (FLUX).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional: use a system FFmpeg instead of the bundled ffmpeg-static binary.
# FFMPEG_PATH=
