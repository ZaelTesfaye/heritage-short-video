{
  "models": {
    "tts": {
      "provider": "gemini",
      "model": "gemini-3.8-flash-tts",
      "fallback_models": [
        "gemini-3.8-flash-lite-tts",
        "gemini-2.5-flash-preview-tts"
      ],
      "min_interval_ms": 21000
    },
    "text": {
      "provider": "gemini",
      "model": "gemini-3.8-flash"
    },
    "image": {
      "provider": "cloudflare",
      "model": "@cf/black-forest-labs/flux-2-klein-4b",
      "steps": 4
    },
    "video": {
      "provider": "kaggle",
      "model": "Wan-AI/Wan2.2-TI2V-5B",
      "clip_seconds": 5,
      "draft_resolution": "480p"
    },
    "music": {
      "provider": "kaggle",
      "model": "ACE-Step/ACE-Step-1.5"
    }
  },
  "aspects": {
    "vertical": {
      "width": 1080,
      "height": 1920,
      "keyframe": {
        "width": 768,
        "height": 1344
      },
      "subtitle": {
        "font_size": 44,
        "margin_v": 400,
        "margin_h": 90
      }
    },
    "horizontal": {
      "width": 1920,
      "height": 1080,
      "keyframe": {
        "width": 1344,
        "height": 768
      },
      "subtitle": {
        "font_size": 50,
        "margin_v": 70,
        "margin_h": 160
      }
    }
  },
  "retry": {
    "max_attempts": 4,
    "base_delay_ms": 2000,
    "max_delay_ms": 60000
  },
  "audio": {
    "voice_lufs": -16,
    "music_lufs": -22,
    "music_gain_db": 0,
    "duck": {
      "threshold": 0.02,
      "ratio": 6,
      "attack_ms": 300,
      "release_ms": 1500
    },
    "master_lufs": -14,
    "master_true_peak_db": -1,
    "music_fade_in_s": 1.5,
    "music_fade_out_s": 3
  },
  "video": {
    "crf": 18,
    "preset": "medium",
    "kenburns_supersample": 2
  },
  "pricing": {
    "_note": "List prices used only to compute a list-price EQUIVALENT in runs.jsonl. Everything in this project ran on free tiers. Sources and the date checked are in COSTS.md.",
