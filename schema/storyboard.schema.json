{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/heritage-short/storyboard.schema.json",
  "title": "Storyboard",
  "description": "The contract between every pipeline stage. Each stage reads this file and writes only its own outputs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "title",
    "meta",
    "style",
    "characters",
    "narration",
    "music",
    "end_card",
    "shots"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "logline": {
      "type": "string"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audience",
        "intent",
        "default_language",
        "languages",
        "fps",
        "target_duration_s"
      ],
      "properties": {
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "intent": {
          "type": "string",
          "minLength": 1
        },
        "default_language": {
          "$ref": "#/$defs/lang"
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "name",
              "review"
            ],
            "properties": {
              "code": {
                "$ref": "#/$defs/lang"
              },
              "name": {
                "type": "string"
              },
              "review": {
                "type": "string",
                "description": "Who has checked this language's narration text and audio, and when."
              }
            }
          }
        },
        "fps": {
          "type": "integer",
          "enum": [
            24,
            25,
            30
          ]
        },
        "target_duration_s": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "style_block"
      ],
      "properties": {
        "style_block": {
          "type": "string",
          "minLength": 1,
          "description": "Fixed look description appended to every image prompt."
        }
      }
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "sheet_prompt",
          "seed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "Fixed wording attached to every shot this character appears in."
          },
          "sheet_prompt": {
            "type": "string",
            "minLength": 1,
            "description": "Prompt for the reference sheet generated before any keyframe."
          },
          "seed": {
            "$ref": "#/$defs/seed"
          }
        }
      }
    },
    "narration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "voice",
        "style",
        "lead_in_s",
        "tail_s"
      ],
      "properties": {
        "voice": {
          "type": "string",
          "minLength": 1
        },
        "style": {
          "type": "string",
          "description": "Plain-language delivery instruction for the TTS model."
        },
        "lead_in_s": {
          "type": "number",
          "minimum": 0,
          "description": "Silence after a cut before the voice starts."
        },
        "tail_s": {
          "type": "number",
          "minimum": 0,
          "description": "Silence after the voice ends before the next cut."
        }
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caption",
        "bpm",
        "key",
        "duration_s",
        "candidates",
        "chosen",
        "cues"
      ],
      "properties": {
        "caption": {
          "type": "string",
          "minLength": 1
        },
        "bpm": {
          "type": "integer",
          "minimum": 40,
          "maximum": 200
        },
        "key": {
          "type": "string"
        },
        "duration_s": {
          "type": "number",
          "minimum": 10
        },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "seed"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9_]+$"
              },
              "seed": {
                "$ref": "#/$defs/seed"
              }
            }
          }
        },
        "chosen": {
          "type": [
            "string",
            "null"
          ],
          "description": "Id of the chosen candidate, or null to use the synthesized placeholder."
        },
        "chosen_reason": {
          "type": "string"
        },
        "cues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "shot",
              "note"
            ],
            "properties": {
              "shot": {
                "$ref": "#/$defs/shotId"
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "end_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lines",
        "duration_s"
      ],
      "properties": {
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "duration_s": {
          "type": "number",
          "minimum": 2,
          "maximum": 6
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/shot"
      }
    }
  },
  "$defs": {
    "lang": {
      "type": "string",
      "pattern": "^[a-z]{2,3}$"
    },
    "shotId": {
      "type": "string",
      "pattern": "^s[0-9]{2}$"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "unit": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reason",
        "shot_size",
        "duration_s",
        "characters",
        "image_prompt",
        "seed",
        "motion",
        "narration",
        "subtitle"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/shotId"
        },
        "reason": {
          "type": "string",
          "minLength": 10,
          "description": "Why this shot exists. If it cannot be stated, the shot should be cut."
        },
        "shot_size": {
          "enum": [
            "extreme_wide",
            "wide",
            "medium",
            "medium_close_up",
            "close_up",
            "insert"
          ]
        },
        "duration_s": {
          "type": "number",
          "minimum": 2,
          "maximum": 15,
          "description": "Planned minimum length. The real length grows to fit the narration."
        },
        "characters": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Ids from `characters` visible in this shot."
        },
        "image_prompt": {
          "type": "string",
          "minLength": 10
        },
        "seed": {
          "$ref": "#/$defs/seed"
        },
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "prompt",
            "kenburns"
          ],
          "properties": {
            "mode": {
              "enum": [
                "kenburns",
                "i2v"
              ],
              "description": "i2v uses an image-to-video clip when one exists and falls back to kenburns when it does not."
            },
            "prompt": {
              "type": "string",
              "description": "Motion and camera only. The keyframe already holds the subject."
            },
            "seed": {
              "$ref": "#/$defs/seed"
            },
            "kenburns": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "zoom_from",
                "zoom_to",
                "x_from",
                "x_to",
                "y_from",
                "y_to"
              ],
              "properties": {
                "zoom_from": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 2
                },
                "zoom_to": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 2
                },
                "x_from": {
                  "$ref": "#/$defs/unit"
                },
                "x_to": {
                  "$ref": "#/$defs/unit"
                },
                "y_from": {
                  "$ref": "#/$defs/unit"
                },
                "y_to": {
                  "$ref": "#/$defs/unit"
                }
              }
            }
          }
        },
        "narration": {
          "type": "object",
          "description": "Narration text per language code.",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z]{2,3}$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "subtitle": {
          "type": "string",
          "minLength": 1,
          "description": "English subtitle shown while the narration plays."
        },
        "music_cue": {
          "type": "string"
        },
        "use_reference_sheets": {
          "type": "boolean",
          "description": "Condition this keyframe on the characters' reference sheets (default true). Turn off for a shot where the multi-view sheet makes the model repeat the character."
        }
      }
    }
  }
}
